# 백엔드 API 명세서 기준 Base URL (아직 미정, 팀에게 확인 후 교체)
# 각 API 경로 자체에 /api/auth, /api/v1 프리픽스가 이미 포함되어 있으므로
# 여기엔 오리진(프로토콜+호스트+포트)만 넣는다
VITE_API_BASE_URL=http://localhost:8080

# 카카오 지도 JavaScript 키 (Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키)
# [앱 설정 > 플랫폼 > Web]에 사용하는 도메인(예: http://localhost:5173)을 반드시 등록해야
# 지도가 정상적으로 로드된다.
VITE_KAKAO_MAP_KEY=
